    prev_pos = None
    canvas = None

    while True:
        success, img = cap.read()
        img = cv2.flip(img, 1)

        if canvas is None:
            canvas = np.zeros_like(img)
            img_clean = img.copy()

        if not success:
            break

        info = getHandInfo(img, detector)
        if info:
            fingers, lmList = info
            prev_pos, canvas = draw(info, prev_pos, canvas)  # Correctly update prev_pos and canvas
            sendToAI(model,canvas, fingers)

            image_combined = cv2.addWeighted(img, 0.85, canvas, 0.3, 0)

        cv2.imshow("Image", img)
        cv2.imshow("canvas", canvas)
